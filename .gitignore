# Python caches, virtual environments, and coverage output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Local environment files (keep the documented template tracked)
.env
.env.*
!.env.example

# Local application data and backups
memory.jsonl
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.legacy-backup-*
*.db
*.db-shm
*.db-wal
/instance/

# Local design references, test experiments, and generated caches
/Settings-html/
/test.py
/cloud_test.py
/hts-cache/
/admin_users.html
/.neon
/.neon/

# Node dependencies and temporary/editor files
node_modules/
npm-debug.log*
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# Android signing material must never enter source control (any directory).
*.keystore
*.jks
*.p12
*.pfx
*.apk
*.aab
*.apks
*.idsig
