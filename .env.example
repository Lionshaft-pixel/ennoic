# Copy to .env and replace values. Never commit real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=Ennoic <no-reply@example.com>
# Use true only for SMTP-over-TLS (typically port 465). Port 587 uses STARTTLS.
SMTP_USE_SSL=false
PUBLIC_URL=http://127.0.0.1:5000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Subscription entitlements. Defaults are Free: 40 AI requests/month, 40 memories,
# 10 visible conversations; Pro: 1000 AI requests/month, 1000 memories, full history.
ENNOIC_FREE_AI_REQUESTS_MONTHLY=40
ENNOIC_PRO_AI_REQUESTS_MONTHLY=1000
ENNOIC_FREE_MEMORY_CAPACITY=40
ENNOIC_PRO_MEMORY_CAPACITY=1000
ENNOIC_FREE_CONVERSATION_HISTORY=10
ENNOIC_PRO_CONVERSATION_HISTORY=0
ENNOIC_FREE_ATTACHMENT_COUNT=3
ENNOIC_PRO_ATTACHMENT_COUNT=20
ENNOIC_FREE_ATTACHMENT_FILE_BYTES=5242880
ENNOIC_PRO_ATTACHMENT_FILE_BYTES=52428800
ENNOIC_FREE_ATTACHMENT_STORAGE_BYTES=52428800
ENNOIC_PRO_ATTACHMENT_STORAGE_BYTES=1073741824
ENNOIC_FREE_FILE_ANALYSIS_MONTHLY=0
ENNOIC_PRO_FILE_ANALYSIS_MONTHLY=50
ENNOIC_PRO_PRICE_INR_MINOR=17900
ENNOIC_PRO_PRICE_USD_MINOR=499

# Comma-separated sign-in emails allowed to view /admin/users.
ENNOIC_ADMIN_EMAILS=your-sign-in-email@example.com
# Optional country header from a trusted reverse proxy (for example CF-IPCountry).
# Leave blank unless requests can only reach the app through that trusted proxy.
ENNOIC_COUNTRY_HEADER=

# Razorpay test credentials and monthly subscription plan IDs. Keep secrets out of source control.
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_PRO_PLAN_ID_INR=
RAZORPAY_PRO_PLAN_ID_USD=
RAZORPAY_WEBHOOK_SECRET=
